# Supabase (optional — leave blank for local-only mode)
# Create a project at https://supabase.com, run supabase/migrations/001_initial.sql,
# then enable Auth providers you want (Email, Phone+Twilio, Google) as equal options.
# Optional: Authentication → MFA → enable TOTP.
# Optional Z.ai CORS relay: deploy supabase/functions/ai-proxy (signed-in users only).
# Hosted credits (optional): run supabase/migrations/003_billing.sql and deploy
# ensure-billing, create-checkout-session, create-portal-session, stripe-webhook,
# hosted-ai, and delete-account. Set these as Supabase function secrets, not Vite vars:
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTHLY, STRIPE_PRICE_PACK
#   HOSTED_CHAT_BASE_URL, HOSTED_CHAT_API_KEY, HOSTED_PROSE_MODEL, HOSTED_UTILITY_MODEL, HOSTED_IMAGE_MODEL
#   HOSTED_IMAGE_BASE_URL (optional; defaults to HOSTED_CHAT_BASE_URL)
# stripe-webhook must be deployed with verify_jwt = false (see supabase/config.toml).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
